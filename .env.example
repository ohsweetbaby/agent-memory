# Agent Memory 本地运行环境设置
# 复制为 .env 后填写；.env 不会被提交。
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-generate-a-random-secret

# 端口映射（仅 api 与 web 暴露到宿主机）
API_PORT=8000
WEB_PORT=8080

# 前端镜像构建时的 npm registry；国内可改为 npmmirror。
NPM_REGISTRY=https://registry.npmjs.org

# 资产目录（容器内由 worker 读写）
ASSETS_DIR=/data/assets

# PostgreSQL（事实源）
POSTGRES_DB=agent_memory
POSTGRES_USER=agent_memory
POSTGRES_PASSWORD=change-me-postgres

# 内部服务地址：容器内使用服务名；本机直接运行 API 时改为 localhost。
# DATABASE_URL=postgresql+psycopg://agent_memory:change-me-postgres@postgres:5432/agent_memory
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# NEO4J_URI=bolt://neo4j:7687

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# 模型 Provider；LLM_API_KEY 只放环境变量
# EMBEDDING_PROVIDER=fake 时使用确定性向量，适合本地开发与测试。
# EMBEDDING_PROVIDER=local 需要 `uv sync --extra local-embeddings`。
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 留空复用 LLM_BASE_URL；嵌入服务独立部署时再填写。
EMBEDDING_BASE_URL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# 检索：查询改写默认关闭；上下文预算单位为估算 token。
SEARCH_QUERY_REWRITE=false
SEARCH_CONTEXT_BUDGET_TOKENS=1500

# 对话抽取：同时达到置信度与重要性阈值才自动入库，否则进入待审队列。
AUTO_ACCEPT_CONFIDENCE=0.75
AUTO_ACCEPT_IMPORTANCE=0.5
REVIEW_RETENTION_DAYS=90

# 巩固：空闲阈值与夜间批量执行时刻（UTC）。
CONSOLIDATION_IDLE_MINUTES=30
CONSOLIDATION_NIGHTLY_HOUR=3
CONSOLIDATION_NIGHTLY_MINUTE=0

# 遗忘与清理（UTC）：04:00 归档、05:00 物理清理与历史裁剪。
DECAY_BASE_STABILITY_DAYS=7
DECAY_ARCHIVE_THRESHOLD=0.15
DECAY_SWEEP_HOUR=4
PURGE_RETENTION_DAYS=30
PURGE_DELETED_HOUR=5
AUDIT_RETENTION_DAYS=180
RECONCILE_SAMPLE_SIZE=100
# 导出目录由 api 与 worker 共享的 exports_data 卷提供。
EXPORT_DIR=/data/exports

# 开发期允许跨域的管理台地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# MCP：默认挂载 /mcp（Streamable HTTP）。
# 直接暴露 MCP（不经 Nginx）时填写 Host/Origin 白名单以开启 DNS rebinding 校验。
MCP_ENABLED=true
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# stdio 薄桥 `memory-mcp` 读取以下变量（也可用 --api-url / --api-key）：
# MEMORY_API_URL=http://localhost:8000
# MEMORY_API_KEY=
